{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "alda",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "SYMBOL",
        "name": "_toplevel"
      }
    },
    "_toplevel": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "part_declaration"
        },
        {
          "type": "SYMBOL",
          "name": "variable_definition"
        },
        {
          "type": "SYMBOL",
          "name": "_event"
        },
        {
          "type": "PATTERN",
          "value": "\\n"
        }
      ]
    },
    "comment": {
      "type": "PATTERN",
      "value": "#[^\\n]*"
    },
    "part_declaration": {
      "type": "PREC_RIGHT",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "instrument_call"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "_event"
            }
          }
        ]
      }
    },
    "instrument_call": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "identifier"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": "/"
              },
              {
                "type": "SYMBOL",
                "name": "identifier"
              }
            ]
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "string"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "STRING",
          "value": ":"
        }
      ]
    },
    "variable_definition": {
      "type": "PREC_RIGHT",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "identifier"
          },
          {
            "type": "STRING",
            "value": "="
          },
          {
            "type": "REPEAT1",
            "content": {
              "type": "SYMBOL",
              "name": "_event"
            }
          }
        ]
      }
    },
    "_event": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "note"
        },
        {
          "type": "SYMBOL",
          "name": "rest"
        },
        {
          "type": "SYMBOL",
          "name": "chord"
        },
        {
          "type": "SYMBOL",
          "name": "sexp"
        },
        {
          "type": "SYMBOL",
          "name": "octave_set"
        },
        {
          "type": "SYMBOL",
          "name": "octave_up"
        },
        {
          "type": "SYMBOL",
          "name": "octave_down"
        },
        {
          "type": "SYMBOL",
          "name": "barline"
        },
        {
          "type": "SYMBOL",
          "name": "marker"
        },
        {
          "type": "SYMBOL",
          "name": "at_marker"
        },
        {
          "type": "SYMBOL",
          "name": "voice_marker"
        },
        {
          "type": "SYMBOL",
          "name": "cram"
        },
        {
          "type": "SYMBOL",
          "name": "bracket_seq"
        }
      ]
    },
    "note": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "pitch"
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "duration"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "repeat_count"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "on_repetitions"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "pitch": {
      "type": "SEQ",
      "members": [
        {
          "type": "SYMBOL",
          "name": "note_letter"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "accidental"
          }
        }
      ]
    },
    "note_letter": {
      "type": "PATTERN",
      "value": "[a-gA-G]"
    },
    "accidental": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "+"
        },
        {
          "type": "STRING",
          "value": "-"
        },
        {
          "type": "STRING",
          "value": "_"
        }
      ]
    },
    "rest": {
      "type": "SEQ",
      "members": [
        {
          "type": "PATTERN",
          "value": "[rR]"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "duration"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "repeat_count"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "on_repetitions"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "chord": {
      "type": "PREC_LEFT",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "pitch"
          },
          {
            "type": "REPEAT1",
            "content": {
              "type": "SEQ",
              "members": [
                {
                  "type": "STRING",
                  "value": "/"
                },
                {
                  "type": "CHOICE",
                  "members": [
                    {
                      "type": "SYMBOL",
                      "name": "pitch"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "octave_up"
                    },
                    {
                      "type": "SYMBOL",
                      "name": "octave_down"
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "duration"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "repeat_count"
              },
              {
                "type": "BLANK"
              }
            ]
          },
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "SYMBOL",
                "name": "on_repetitions"
              },
              {
                "type": "BLANK"
              }
            ]
          }
        ]
      }
    },
    "duration": {
      "type": "PREC_LEFT",
      "value": 0,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_duration_value"
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "dot"
            }
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "tie_duration"
            }
          }
        ]
      }
    },
    "_duration_value": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "note_length"
        },
        {
          "type": "SYMBOL",
          "name": "duration_ms"
        },
        {
          "type": "SYMBOL",
          "name": "duration_s"
        }
      ]
    },
    "note_length": {
      "type": "PATTERN",
      "value": "[1-9][0-9]*"
    },
    "duration_ms": {
      "type": "PATTERN",
      "value": "[0-9]+ms"
    },
    "duration_s": {
      "type": "PATTERN",
      "value": "[0-9]+s"
    },
    "dot": {
      "type": "STRING",
      "value": "."
    },
    "tie_duration": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "~"
        },
        {
          "type": "SYMBOL",
          "name": "_duration_value"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "dot"
          }
        }
      ]
    },
    "octave_set": {
      "type": "PATTERN",
      "value": "o[0-9]"
    },
    "octave_up": {
      "type": "STRING",
      "value": ">"
    },
    "octave_down": {
      "type": "STRING",
      "value": "<"
    },
    "barline": {
      "type": "STRING",
      "value": "|"
    },
    "marker": {
      "type": "PATTERN",
      "value": "%[a-zA-Z_][a-zA-Z0-9_\\-]*"
    },
    "at_marker": {
      "type": "PATTERN",
      "value": "@[a-zA-Z_][a-zA-Z0-9_\\-]*"
    },
    "voice_marker": {
      "type": "PATTERN",
      "value": "V[0-9]+:"
    },
    "cram": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "{"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_event"
          }
        },
        {
          "type": "STRING",
          "value": "}"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "duration"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "repeat_count"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "bracket_seq": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_event"
          }
        },
        {
          "type": "STRING",
          "value": "]"
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "duration"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "repeat_count"
            },
            {
              "type": "BLANK"
            }
          ]
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "SYMBOL",
              "name": "on_repetitions"
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "repeat_count": {
      "type": "PATTERN",
      "value": "\\*[0-9]+"
    },
    "on_repetitions": {
      "type": "PATTERN",
      "value": "'[0-9,\\-]+"
    },
    "sexp": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SYMBOL",
            "name": "_sexp_item"
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "_sexp_item": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "sexp_symbol"
        },
        {
          "type": "SYMBOL",
          "name": "sexp_number"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "SYMBOL",
          "name": "quoted_list"
        },
        {
          "type": "SYMBOL",
          "name": "sexp"
        }
      ]
    },
    "sexp_symbol": {
      "type": "PATTERN",
      "value": "[a-zA-Z_!?+\\-*/<>=.:][a-zA-Z0-9_!?+\\-*/<>=.:]*"
    },
    "sexp_number": {
      "type": "PATTERN",
      "value": "-?[0-9]+(\\.[0-9]+)?"
    },
    "quoted_list": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "'"
        },
        {
          "type": "SYMBOL",
          "name": "sexp"
        }
      ]
    },
    "string": {
      "type": "PATTERN",
      "value": "\"[^\"]*\""
    },
    "identifier": {
      "type": "PATTERN",
      "value": "[a-zA-Z_][a-zA-Z0-9_\\-]*"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[ \\t\\r]+"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [
    [
      "note",
      "chord"
    ]
  ],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}